{
  "name": "consify-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "apps/demo/lattice"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "PATH=\"$PWD/packages/core/bin:$PATH\" bun run --filter '*' typecheck",
    "check": "bun run lint && bun run typecheck && bun test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "demo": "PATH=\"$PWD/packages/core/bin:$PATH\" bun run --cwd apps/demo dev --port 3300",
    "starter": "PATH=\"$PWD/packages/core/bin:$PATH\" bun run --cwd apps/starter dev",
    "build:demo": "PATH=\"$PWD/packages/core/bin:$PATH\" bun run --cwd apps/demo build",
    "start:demo": "PATH=\"$PWD/packages/core/bin:$PATH\" bun run --cwd apps/demo start",
    "docs": "PATH=\"$PWD/packages/core/bin:$PATH\" bun run --cwd apps/docs dev --port 3500",
    "build:docs": "PATH=\"$PWD/packages/core/bin:$PATH\" bun run --cwd apps/docs build",
    "start:docs": "PATH=\"$PWD/packages/core/bin:$PATH\" bun run --cwd apps/docs start",
    "docs:check": "bun run skills/consify-docs/scripts/check-docs.ts --root apps/docs --languages en,ru --strict"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  }
}
