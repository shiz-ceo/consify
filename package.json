{
  "name": "consify-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "integrations/*",
    "apps/*",
    "apps/demo/lattice",
    "e2e"
  ],
  "scripts": {
    "test": "bun test packages integrations",
    "typecheck": "PATH=\"$PWD/packages/cli/bin:$PATH\" bun run --filter '*' typecheck",
    "check": "bun run lint && bun run typecheck && bun run prepare:template && bun test packages integrations",
    "lint": "biome check .",
    "format": "biome check --write .",
    "demo": "PATH=\"$PWD/packages/cli/bin:$PATH\" bun run --cwd apps/demo dev --port 3300",
    "starter": "PATH=\"$PWD/packages/cli/bin:$PATH\" bun run --cwd apps/starter dev",
    "build:demo": "PATH=\"$PWD/packages/cli/bin:$PATH\" bun run --cwd apps/demo build",
    "start:demo": "PATH=\"$PWD/packages/cli/bin:$PATH\" bun run --cwd apps/demo start",
    "docs": "PATH=\"$PWD/packages/cli/bin:$PATH\" bun run --cwd apps/docs dev --port 3500",
    "build:docs": "PATH=\"$PWD/packages/cli/bin:$PATH\" bun run --cwd apps/docs build",
    "start:docs": "PATH=\"$PWD/packages/cli/bin:$PATH\" bun run --cwd apps/docs start",
    "docs:check": "PATH=\"$PWD/packages/cli/bin:$PATH\" bun run --cwd apps/docs check",
    "check:package": "bun run scripts/check-package.ts",
    "prepare:template": "bun run --cwd packages/create-consify prepare-template",
    "check:build": "bun run scripts/check-build.ts",
    "build:packages": "bun run --filter './packages/*' --filter './integrations/*' build",
    "e2e": "bun run scripts/e2e.ts",
    "e2e:themes": "bun run --cwd e2e themes"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/bun": "^1.4.2",
    "typescript": "6.0.3"
  },
  "overrides": {
    "lodash-es": "4.18.1",
    "@ai-sdk/provider-utils": "4.0.33"
  }
}
