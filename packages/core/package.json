{
  "name": "@consify/core",
  "version": "1.0.3",
  "description": "The core of a customizable documentation site: config, layout, theme, features, Vite and React Router integration",
  "license": "MIT",
  "keywords": [
    "documentation",
    "docs",
    "mdx",
    "fumadocs",
    "react-router",
    "vite",
    "i18n",
    "blog",
    "static-site"
  ],
  "author": "Shiz-Ceo",
  "homepage": "https://github.com/shiz-ceo/consify#readme",
  "bugs": {
    "url": "https://github.com/shiz-ceo/consify/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shiz-ceo/consify.git",
    "directory": "packages/core"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./runtime": "./src/runtime/index.ts",
    "./runtime/server": "./src/runtime/server.ts",
    "./ui": "./src/ui.ts",
    "./node": "./src/node.ts",
    "./vite": "./src/build/vite/index.ts",
    "./react-router": "./src/build/router/config.ts",
    "./react-router/routes": "./src/build/router/routes.ts",
    "./react-router/root": "./src/build/router/root.tsx",
    "./react-router/instance": "./src/build/router/instance.d.ts",
    "./components": "./src/shared/ui/index.ts",
    "./plugins": "./src/plugins/index.ts",
    "./search": "./src/shared/fumadocs-search.ts",
    "./theme.css": "./src/theme/theme.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun test",
    "build": "bun run ../../scripts/build-package.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
