    "@react-router/serve": "8.4.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/mdx": "2.0.14",
    "fumadocs-core": "16.15.13",
    "fumadocs-twoslash": "3.3.1",
    "fumadocs-ui": "16.15.13",
    "isbot": "5.2.2",
    "katex": "0.18.9",
    "lucide-react": "1.47.0",
    "mermaid": "12.0.0",
    "next-themes": "0.4.6",
    "rehype-katex": "7.0.1",
    "remark-math": "6.0.0",
    "shiki": "4.4.3",
    "tailwindcss": "4.3.3",
    "takumi-js": "2.14.0",
    "typescript": "6.0.3",
    "unified": "11.0.5",
    "yaml": "2.9.1",
    "zod": "4.6.5"
