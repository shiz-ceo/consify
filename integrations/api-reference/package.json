{
  "name": "@consify/api-reference",
  "version": "0.1.0",
  "description": "An API reference for a consify documentation site, generated from an OpenAPI schema with Scalar",
  "license": "MIT",
  "keywords": [
    "consify",
    "openapi",
    "api-reference",
    "scalar"
  ],
  "author": "Shiz-Ceo",
  "homepage": "https://github.com/shiz-ceo/consify#readme",
  "bugs": {
    "url": "https://github.com/shiz-ceo/consify/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shiz-ceo/consify.git",
    "directory": "integrations/api-reference"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun test",
    "build": "bun run ../../scripts/build-package.ts"
  },
  "dependencies": {
    "next-themes": "0.4.6",
    "@scalar/api-reference-react": "0.9.74"
  },
  "devDependencies": {
    "@consify/core": "workspace:*",
    "@types/mdx": "2.0.14",
    "@types/node": "24",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "vite": "8.3.0"
  },
  "peerDependencies": {
    "@consify/core": "^0.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^8.4.0"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "consify": {
    "prebundle": [
      "@scalar/api-reference-react"
    ]
  }
}
