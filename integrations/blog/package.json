{
  "name": "@consify/blog",
  "version": "1.0.3",
  "description": "A blog for a consify documentation site: posts in MDX, categories, authors, search, an RSS feed and social images",
  "license": "MIT",
  "keywords": [
    "consify",
    "blog",
    "rss",
    "mdx"
  ],
  "author": "Shiz-Ceo",
  "homepage": "https://github.com/shiz-ceo/consify#readme",
  "bugs": {
    "url": "https://github.com/shiz-ceo/consify/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shiz-ceo/consify.git",
    "directory": "integrations/blog"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun test",
    "build": "bun run ../../scripts/build-package.ts"
  },
  "dependencies": {
    "fumadocs-core": "16.15.13",
    "fumadocs-ui": "16.15.13",
    "lucide-react": "1.47.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@consify/core": "workspace:*",
    "@types/mdx": "2.0.14",
    "@types/node": "24",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "vite": "8.3.0"
  },
  "peerDependencies": {
    "@consify/core": "^1.0.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^8.4.0"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "consify": {
    "prebundle": [
      "fumadocs-ui/components/inline-toc",
      "fumadocs-ui/components/toc",
      "fumadocs-ui/components/toc/default",
      "lucide-react"
    ]
  }
}
